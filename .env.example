# ============================================================
# Odoo AI Module Generator - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Core application ----------------------------------------
REDIS_URL=rediss://default:your_redis_password@your_upstash_host:6379

# ---- Authentication (JWT) ----------------------------------
# Login credentials used by POST /api/auth/login. Login is disabled until
# ADMIN_PASSWORD is set. Keep JWT_SECRET a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# ---- Supabase (optional) -----------------------------------
# Enables:
#   1. Persisting generation jobs / chat history in the cloud.
#   2. User login via Supabase Auth (the frontend sends the user's Supabase
#      session token to /api/auth/login with provider=supabase).
#   3. Direct Supabase JWT verification: pass the user's Supabase access token
#      straight in `Authorization: Bearer <token>` and it will be verified
#      against SUPABASE_JWT_SECRET (Project Settings > API > JWT Secret).
# SUPABASE_KEY can be the anon key (for job persistence) or a service key.
SUPABASE_URL=your_project_url
SUPABASE_KEY=your_anon_or_service_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ---- Role-based quota limits (optional) --------------------
# Daily token ceilings enforced on /analyze-requirements/ and /generate-module/.
# Used only when the user's `public.profiles.token_limit` is unset; a value of
# 0 (or leaving it empty) means unlimited for that role. Admins always bypass.
# DEFAULT_TOKEN_LIMIT applies to authenticated users, GUEST_TOKEN_LIMIT to
# anonymous Supabase sessions (no email).
DEFAULT_TOKEN_LIMIT=5000
GUEST_TOKEN_LIMIT=1000

# ---- AI Provider Keys (at least ONE is required) -----------

# Gemini (Google) - direct API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (aggregates many models, including Gemini)
OPENROUTER_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Bynara / NaraRouter (custom gateway)
BYNARA_KEY=your_bynara_key_here
BYNARA_URL=https://router.bynara.id/v1
BYNARA_MODELS=claude-sonnet-4.5,mistral-large,claude-haiku-4.5

# ---- AI Provider Order (optional) -------------------------
# Comma-separated list; first working provider is used
# Choices: nara, gemini, openrouter
AI_PROVIDER_ORDER=nara,gemini,openrouter

# ---- GitHub Deployment (optional) -------------------------
# Only needed if you want git_deploy_target: "github"
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USER=your_github_username

# ---- RAG Service (optional, uses defaults if not set) ------
RAG_PERSIST_DIRECTORY=chroma_db
RAG_COLLECTION_NAME=odoo_reference
RAG_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_ODDO_ADDONS_PATH=odoo/addons
